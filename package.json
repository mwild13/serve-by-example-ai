{
  "name": "serve-by-example-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:css": "node scripts/lint-css-tokens.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:cloudflare": "npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion && node -e \"const fs=require('fs'),path=require('path');const src=path.join('.open-next','assets');for(const f of fs.readdirSync(src,{withFileTypes:true,recursive:true})){if(f.isFile()){const rel=path.relative(src,path.join(f.parentPath||f.path,f.name));const dst=path.join('.open-next',rel);fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(path.join(f.parentPath||f.path,f.name),dst)}}fs.copyFileSync('.open-next/worker.js','.open-next/_worker.js');fs.writeFileSync('.open-next/_routes.json',JSON.stringify({version:1,include:['/*'],exclude:['/_next/static/*','/favicon.ico','/*.svg','/downloads/*','/*.png','/*.webp','/*.jpg','/*.jpeg','/manifest.json','/llms.txt','/images/*']}));\"",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "knip": "npx --yes knip@6 --no-progress",
    "lint:css:unused": "node scripts/find-unused-css.mjs",
    "questions:review": "node scripts/question-review.mjs",
    "cards:review": "node scripts/learn-card-review.mjs",
    "guests:review": "node scripts/live-guest-review.mjs",
    "rush:review": "node scripts/rush-review.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "~15.5.28",
    "openai": "^6.49.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
